generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  APPLICANT
}

enum ApplicationStatus {
  UNDER_REVIEW
  ADMIN_APPROVED
  APPROVED
  REJECTED
}

enum EditRequestStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum OtpPurpose {
  CANDIDATE
  EMPLOYEE
  LOGIN
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum JobApprovalStatus {
  PENDING
  ADMIN_APPROVED
  APPROVED
  REJECTED
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  mobile        String         @unique
  passwordHash  String
  role          UserRole       @default(EMPLOYEE)
  isActive      Boolean        @default(true)
  branchId      Int?
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  registrations Registration[] @relation("SubmittedRegistrations")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role, isActive])
  @@index([branchId])
}

model Branch {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  isActive      Boolean        @default(true)
  users         User[]
  registrations Registration[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Registration {
  id                         Int                @id @default(autoincrement())
  ref                        String             @unique
  name                       String
  mobile                     String
  designation                String?
  status                     ApplicationStatus  @default(UNDER_REVIEW)
  paymentStatus              PaymentStatus      @default(PENDING)
  feesPaid                   Int                @default(0)
  feesPending                Int                @default(2400)
  details                    Json
  photoUrl                   String?
  addressProofUrl            String?
  addressProofName           String?
  bankProofUrl               String?
  bankProofName              String?
  candidateOtpVerified       Boolean            @default(false)
  employeeOtpVerified        Boolean            @default(false)
  confirmationStatus         NotificationStatus @default(PENDING)
  confirmationMessageId      String?
  adminApprovedById          Int?
  adminApprovedByName        String?
  adminApprovedAt            DateTime?
  superAdminApprovedById     Int?
  superAdminApprovedByName   String?
  superAdminApprovedAt       DateTime?
  rejectionReason            String?
  rejectedByRole             UserRole?
  editRequestStatus          EditRequestStatus  @default(NONE)
  editRequestNotes           String?
  editRequestedAt            DateTime?
  editRequestedByUserId      Int?
  editRequestedByName        String?
  editApprovedById           Int?
  editApprovedByName         String?
  editApprovedAt             DateTime?
  editRejectedById           Int?
  editRejectedByName         String?
  editRejectedAt             DateTime?
  editRequestRejectionReason String?
  submittedByUserId          Int?
  submittedBy                User?              @relation("SubmittedRegistrations", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  submittedByName            String?
  submittedByMobile          String?
  branchId                   Int?
  branch                     Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([mobile])
  @@index([submittedByUserId, createdAt])
  @@index([branchId, createdAt])
  @@index([status, paymentStatus])
  @@index([confirmationStatus, createdAt])
}

model OtpChallenge {
  id         String     @id @default(cuid())
  mobile     String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([mobile, purpose, createdAt])
  @@index([expiresAt])
}

model FeeMaster {
  id          Int      @id @default(autoincrement())
  name        String   @unique @default("Registration Fee")
  amount      Int      @default(2400)
  description String?  @default("Driver and Candidate Registration Processing Fee")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JobApproval {
  id                       Int               @id @default(autoincrement())
  externalJobId            String            @unique
  jobSnapshot              Json
  status                   JobApprovalStatus @default(PENDING)
  adminApprovedById        Int?
  adminApprovedByName      String?
  adminApprovedAt          DateTime?
  superAdminApprovedById   Int?
  superAdminApprovedByName String?
  superAdminApprovedAt     DateTime?
  rejectedById             Int?
  rejectedByName           String?
  rejectedAt               DateTime?
  rejectionReason          String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([status, superAdminApprovedAt])
}
